{
  "name": "rulespec",
  "version": "0.10.0",
  "description": "Business rules as structured data, compiled into LLM-ready markdown prompts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "rulespec": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills/**/*",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.2",
      "minGatewayVersion": ">=2026.5.2"
    },
    "build": {
      "openclawVersion": "2026.5.12"
    }
  },
  "keywords": [
    "business-rules",
    "llm",
    "ai-agents",
    "prompt-engineering",
    "guardrails",
    "compliance",
    "policy",
    "rules-engine",
    "agent-skills",
    "skill-md",
    "yaml",
    "cli"
  ],
  "license": "MIT",
  "author": "pallaoro",
  "repository": {
    "type": "git",
    "url": "https://github.com/pallaoro/rulespec"
  },
  "homepage": "https://github.com/pallaoro/rulespec#readme",
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "ai": ">=4.0.0",
    "@ai-sdk/openai": ">=1.0.0",
    "@ai-sdk/anthropic": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "ai": { "optional": true },
    "@ai-sdk/openai": { "optional": true },
    "@ai-sdk/anthropic": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
